---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import Hero from "@/components/widgets/Hero.astro";
import Features from "@/components/widgets/Features.astro";
import Content2 from "@/components/widgets/Content2.astro";
import ImageCarousel from "@/components/widgets/ImageCarousel.astro";
import AnimatedCTA from "@/components/widgets/AnimatedCTA.astro";

const metadata = {
  title: `${siteConfig.name} — Nätverk och företagsutveckling i Linköping`,
  description: siteConfig.description,
  ignoreTitleTemplate: true,
};

import { sanityClient } from "sanity:client";
import { urlForImage } from "@/utils/image";

const query = `*[_type == "homepage"][0]`;
const page = await sanityClient.fetch(query);

let carouselImages =
  page?.carouselImages?.map((img: any) => ({
    url: urlForImage(img).url(),
    alt: img.alt || "Bild från SMIL aktivitet",
  })) || [];

const shuffleArray = (array: any[]) => {
  for (let i = array.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [array[i], array[j]] = [array[j], array[i]];
  }
  return array;
};

if (page?.shuffleCarousel) {
  carouselImages = shuffleArray(carouselImages);
}
---

<BaseLayout {metadata}>
  <Hero
    title="VÄLKOMMEN TILL SMIL"
    subtitle="Linköpings nätverk för företagsledare och entreprenörer"
    bgImage={{
      src: urlForImage(page.heroImage).url(),
      alt: "SMIL Banner",
    }}
    description={`${siteConfig.description}`}
    actions={page.heroButtons?.map((btn: any) => ({
      text: btn.text,
      href: btn.href,
      variant: btn.variant,
      icon: btn.variant === "primary" ? "lucide:user-plus" : "lucide:smile",
    })) || []}
  />
  <Features
    tagline={page.infoOverline}
    title={page.infoTitle}
    subtitle={page.infoDescription}
    features={[
      {
        title: page.cardOne.title,
        description: page.cardOne.description,
        icon: "lucide:calendar-days",
        iconClass: "bg-primary/10 text-primary",
      },
      {
        title: page.cardTwo.title,
        description: page.cardTwo.description,
        icon: "lucide:book-open",
        iconClass: "bg-primary/10 text-primary",
      },
      {
        title: page.cardThree.title,
        description: page.cardThree.description,
        icon: "lucide:network",
        iconClass: "bg-primary/10 text-primary",
      },
    ]}
  />
  <Content2
    image={urlForImage(page.sloganImage).url()}
    imageAlt={page.sloganImage?.alt || "Development"}
  >
    <Fragment>
      <h3
        class="text-2xl font-bold tracking-tight sm:text-3xl mb-2 whitespace-pre-line"
      >
        {page.sloganTitle}
      </h3>

      <div class="w-24 h-1 bg-primary rounded-full mb-6"></div>
      <div class="space-y-4 text-lg text-muted-foreground">
        {
          page.sloganText?.map((block: any) => (
            <p>
              {block.children?.map((child: any) =>
                child.marks?.includes("strong") ? (
                  <strong>{child.text}</strong>
                ) : (
                  child.text
                ),
              )}
            </p>
          ))
        }
      </div>
    </Fragment>
  </Content2>

  <ImageCarousel
    title={page?.carouselTitle}
    subtitle={page?.carouselSubtitle}
    images={carouselImages}
  />

  <AnimatedCTA
    title={page.endTitle}
    paragraphs={page.textList}
    actions={page.endButtons?.map((btn: any) => ({
      text: btn.text,
      href: btn.href,
      variant: btn.variant,
      icon:
        btn.variant === "primary" ? "lucide:user-plus" : "lucide:calendar-days",
    })) || []}
  />
</BaseLayout>
