---
import ContactSplit from "@/components/widgets/ContactSplit.astro";
import PageTitle from "@/components/widgets/PageTitle.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sanityClient } from "sanity:client";
import { toHTML } from "@portabletext/to-html";
import { urlForImage } from "@/utils/image";

const query = `*[_type == "rhetoricProgram"][0]`;
const page = await sanityClient.fetch(query);

const gridOptions = {
  2: "md:grid-cols-2",
  3: "md:grid-cols-3",
  4: "md:grid-cols-4",
};
const activeGrid =
  gridOptions[page?.bottomColumns as keyof typeof gridOptions] ||
  "md:grid-cols-3";

// 2. Ordlista för bildformat
const aspectOptions = {
  portrait: "aspect-[3/4]",
  landscape: "aspect-[4/3]",
  square: "aspect-square",
};
const activeAspect =
  aspectOptions[page?.imageAspect as keyof typeof aspectOptions] ||
  "aspect-[3/4]";
---

<BaseLayout metadata={{ title: "Managementprogram i retorik" }}>
  <PageTitle title={page?.title} />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 w-full">
    {
      page?.introText && (
        <div
          class="text-xl font-normal text-muted-foreground w-full space-y-6 [&_a]:font-bold [&_a]:underline [&_a]:decoration-primary [&_a]:underline-offset-4 [&_a]:decoration-1 [&_a]:transition-all [&_a]:duration-300 [&_a]:inline-block [&_a:hover]:decoration-secondary"
          set:html={toHTML(page.introText)}
        />
      )
    }
    <hr class="mt-12 border-gray-200 dark:border-slate-800" />
  </section>

  <ContactSplit>
    <div slot="content">
      {
        page?.mainContent && (
          <div
            class="text-lg font-normal text-muted-foreground
            [&_p]:mb-6 [&_p:last-child]:mb-0 [&_p]:leading-relaxed
            [&_strong]:font-bold [&_strong]:text-foreground 
            [&_ul]:list-disc [&_ul]:ml-6 [&_ul]:mb-6 [&_ul]:space-y-2 [&_li::marker]:text-primary
            [&_ol]:list-decimal [&_ol]:ml-6 [&_ol]:mb-6 [&_ol]:space-y-3 [&_ol_li::marker]:text-primary [&_ol_li::marker]:font-bold
            [&_a]:font-medium [&_a]:underline [&_a]:decoration-primary [&_a]:underline-offset-4 [&_a]:decoration-1 [&_a]:transition-all [&_a]:duration-300 [&_a]:inline-block [&_a:hover]:decoration-secondary"
            set:html={toHTML(page.mainContent)}
          />
        )
      }
    </div>

    <div class="w-full">
      {
        page?.formLink ? (
          <div class="rounded-3xl bg-linear-to-br from-primary/10 via-primary/5 to-background border border-primary/20 shadow-xl p-4 md:p-6 group transition-all duration-300 hover:shadow-2xl hover:border-primary/40">
            <iframe
              src={page.formLink}
              class="w-full min-h-[1100px] border-none rounded-xl bg-transparent"
              title="Bli medlem formulär"
              loading="lazy"
            >
              Laddar formulär...
            </iframe>
          </div>
        ) : (
          <div class="p-8 text-center text-muted-foreground border-2 border-dashed rounded-xl">
            Inget formulär inlagt i Sanity ännu.
          </div>
        )
      }
    </div>
  </ContactSplit>

  {
    page?.participantsGallery && page.participantsGallery.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-0">
        {page?.galleryHeading && (
          <h2 class="text-3xl md:text-4xl font-bold font-heading mb-12 text-center">
            {page.galleryHeading}
          </h2>
        )}

        <div class={`grid grid-cols-1 ${activeGrid} gap-8`}>
          {page.participantsGallery.map((participant: any) => (
            <div class="flex flex-col space-y-6 group">
              {/* Kollar om länk finns, om ja -> klickbar a-tagg, om nej -> vanlig div */}
              {participant.link ? (
                <a
                  href={participant.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block overflow-hidden rounded-2xl shadow-lg border border-border/50"
                >
                  <img
                    src={urlForImage(participant).url()}
                    alt={
                      participant.alt ||
                      participant.name ||
                      "Tidigare deltagare"
                    }
                    class={`w-full ${activeAspect} object-cover transform transition-transform duration-500`}
                    loading="lazy"
                  />
                </a>
              ) : (
                <div class="overflow-hidden rounded-2xl shadow-lg border border-border/50">
                  <img
                    src={urlForImage(participant).url()}
                    alt={
                      participant.alt ||
                      participant.name ||
                      "Tidigare deltagare"
                    }
                    class={`w-full ${activeAspect} object-cover transform transition-transform duration-500`}
                    loading="lazy"
                  />
                </div>
              )}

              <div class="flex flex-col space-y-4 px-2">
                {participant.quote && (
                  <p class="text-muted-foreground italic text-lg leading-relaxed">
                    "{participant.quote}"
                  </p>
                )}
                {participant.name && (
                  <p class="font-bold font-heading text-primary">
                    {participant.name}
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
