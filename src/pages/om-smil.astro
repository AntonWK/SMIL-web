---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import SplitContent from "@/components/widgets/SplitContent.astro";
import People from "@/components/widgets/People.astro";
import aboutImage from "@/assets/smil-40.png";
import PageTitle from "@/components/widgets/PageTitle.astro";
import WidgetWrapper from "@/components/widgets/WidgetWrapper.astro";

import { sanityClient } from "sanity:client";

const metadata = {
  title: "About us",
};

interface BoardMember {
  name: string;
  role?: string;
  company: string;
  mail: string;
  imageUrl: string;
}

const query = `*[_type == "styrelse"] {
  name,
  role,
  company,
  "mail": email,
  "imageUrl": image.asset->url
}`;

const rawPeople = await sanityClient.fetch<BoardMember[]>(query);

const getRoleWeight = (role?: string) => {
  const r = role?.toLowerCase() || "";
  if (r.includes("ordförande")) return 1;
  if (r.includes("suppleant")) return 3;
  return 2; // Standard om rollen är tom, eller t.ex. "Ledamot"
};

const people = rawPeople.sort((a, b) => {
  const roleDifference = getRoleWeight(a.role) - getRoleWeight(b.role);

  if (roleDifference !== 0) {
    return roleDifference; // Placerar Ordförande först och Suppleant sist
  }

  return a.name.localeCompare(b.name, "sv");
});

const optimizedImage = await getImage({
  src: aboutImage,
  format: "webp",
});
---

<BaseLayout {metadata}>
  <PageTitle title="Vad är SMIL?" />
  <WidgetWrapper>
    <hr class="border-gray-200 dark:border-slate-800 mb-8" />
    <SplitContent
      description={[
        "SMIL är nätverket för Linköpings entreprenörer och företagsledare. Här får du tillgång till utbildningar, nätverksträffar och seminarier inom områden som berör och utvecklar ditt företagande. Du får också möjlighet att etablera nya affärskontakter – både lokala och globala – via våra nätverksträffar, aktiviteter och workshops.",
        "Tillsammans kan vi skapa en av Europas bästa och mest kreativa entreprenörs- och innovationsmiljöer.",
      ]}
      actions={[
        {
          text: "Bli medlem",
          href: "/bli-medlem",
          variant: "primary",
          icon: "lucide:user-plus",
        },
      ]}
      columnRatio="2/3-1/3"
      items={[
        {
          title: "Kontaktuppgifter",
          icon: "lucide:mail",
          description: ["Mikael Hult", "+46 (0)70 564 25 45"],
          mail: "info@smil.se",
        },
        {
          title: "Faktureringsadress",
          icon: "lucide:receipt",
          mail: "faktura@smil.se",
        },
        {
          title: "Utdelningsadress",
          icon: "lucide:map-pin",
          description: "Rådjursvägen 7, 587 31 Linköping",
        },
      ]}
    />
    <hr class="border-gray-200 dark:border-slate-800 mb-8" />

    <People
      items={people}
      columns={2}
      tagline="Styrelsen"
      title="SMIL-teamet"
    />
  </WidgetWrapper>
</BaseLayout>
