---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import SplitContent from "@/components/widgets/SplitContent.astro";
import People from "@/components/widgets/People.astro";
import aboutImage from "@/assets/smil-40.png";
import PageTitle from "@/components/widgets/PageTitle.astro";
import WidgetWrapper from "@/components/widgets/WidgetWrapper.astro";

import { sanityClient } from "sanity:client";

const metadata = {
  title: "Om SMIL",
};

interface BoardMember {
  name: string;
  role?: string;
  company: string;
  mail: string;
  imageUrl: string;
}

const query = `{
  "page": *[_type == "aboutPage"][0],
  "rawPeople": *[_type == "styrelse"] {
    name,
    role,
    company,
    "mail": email,
    "imageUrl": image.asset->url
  }
}`;

const { page, rawPeople = [] } = await sanityClient.fetch(query);

const getRoleWeight = (role?: string) => {
  const r = role?.toLowerCase() || "";
  if (r.includes("ordförande")) return 1;
  if (r.includes("suppleant")) return 3;
  return 2; // Standard om rollen är tom, eller t.ex. "Ledamot"
};

const people = rawPeople.sort((a: any, b: any) => {
  const roleDifference = getRoleWeight(a.role) - getRoleWeight(b.role);

  if (roleDifference !== 0) {
    return roleDifference; // Placerar Ordförande först och Suppleant sist
  }

  return a.name.localeCompare(b.name, "sv");
});

const optimizedImage = await getImage({
  src: aboutImage,
  format: "webp",
});
---

<BaseLayout {metadata}>
  <PageTitle title={page?.title || "Vad är SMIL?"} />
  <WidgetWrapper>
    <hr class="border-gray-200 dark:border-slate-800 mb-8" />
    <SplitContent
      description={page?.descriptionText || []}
      actions={page?.actionButton
        ? [
            {
              text: page.actionButton.text,
              href: page.actionButton.href,
              variant: "primary",
              icon: "lucide:user-plus",
            },
          ]
        : []}
      columnRatio="2/3-1/3"
      items={[
        {
          title: "Kontaktuppgifter",
          icon: "lucide:mail",
          description: [
            page?.generalContact?.personName,
            page?.generalContact?.phone,
          ].filter(Boolean),
          mail: page?.generalContact?.email,
        },
        {
          title: "Faktureringsadress",
          icon: "lucide:receipt",
          mail: page?.billingContact?.email,
        },
        {
          title: "Utdelningsadress",
          icon: "lucide:map-pin",
          description: page?.deliveryAddress?.address,
        },
      ]}
    />
    <hr class="border-gray-200 dark:border-slate-800 mb-8" />

    <People
      items={people}
      columns={2}
      tagline="Styrelsen"
      title="SMIL-teamet"
    />
  </WidgetWrapper>
</BaseLayout>
