---
import PageTitle from "@/components/widgets/PageTitle.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import WidgetWrapper from "@/components/widgets/WidgetWrapper.astro";
import MembersList from "@/components/widgets/MembersList.astro";

import { sanityClient } from "sanity:client";
import { PortableText } from "astro-portabletext";

const query = `{
  "landing": *[_type == "memberPage"][0],
  "members": *[_type == "member"] | order(name asc) {
    name,
    "slug": slug.current,
    category,
    "logo": logo.asset->url,
    website
  }
}`;

const { landing, members } = await sanityClient.fetch(query);

const metadata = {
  title: "Medlemsregister",
};
---

<BaseLayout metadata={metadata}>
  <PageTitle title={landing?.title || "Medlemsregister"} />
  <WidgetWrapper containerClass="pt-0 md:pt-0">
    <div class="grid md:grid-cols-2 gap-8 text-left text-lg mt-8 mb-12">
      <div>
        <div class="[&>p]:mb-4 last:[&>p]:mb-0">
          <PortableText value={landing?.columnOneText} />
        </div>
      </div>
      <div>
        <div
          class="[&>p]:mb-4 last:[&>p]:mb-0 [&_a]:underline [&_a]:decoration-primary [&_a]:decoration-2 [&_a]:underline-offset-4 [&_a]:hover:text-primary [&_a]:transition-colors"
        >
          <PortableText value={landing?.columnTwoText} />
        </div>
      </div>
    </div>

    <div
      class="max-w-9xl mx-auto p-8 md:p-12 mb-0 rounded-[2.5rem] shadow-xl border border-black/5 bg-primary/5 relative"
    >
      <MembersList />
    </div>
  </WidgetWrapper>
</BaseLayout>
