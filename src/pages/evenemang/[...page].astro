---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sanityClient } from "sanity:client";
import Headline from "@/components/ui/Headline.astro";
import Pagination from "@/components/ui/Pagination.astro";
import PostItem from "@/components/evenemang/PostItem.astro";
import type { GetStaticPathsOptions } from "astro";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const query = `{
    "landing": *[_type == "eventLanding"][0],
    "sanityEvents": *[_type == "evenemang"] {
      title,
      "slug": slug.current,
      date,
      description,
      eventType,
      location,
      "image": image.asset->url,
      startTime,
      endTime
    }
  }`;

  const { landing, sanityEvents } = await sanityClient.fetch(query);

  // Mappa om så det matchar din befintliga struktur med .data
  const evenemangEntries = sanityEvents.map((event: any) => ({
    id: event.slug,
    slug: event.slug,
    data: {
      ...event,
      date: new Date(event.date),
      slug: event.slug,
    },
  }));

  const today = new Date();
  today.setHours(0, 0, 0, 0);

  const sortedPosts = evenemangEntries
    .filter((post: any) => post.data && post.data.date)
    .filter((post: any) => new Date(post.data.date) >= today) // Visa bara framtida datum
    .sort((a: any, b: any) => a.data.date.valueOf() - b.data.date.valueOf());

  return paginate(sortedPosts, {
    pageSize: 6,
    props: { landing },
  });
}

const { page, landing } = Astro.props;
const evenemang = page.data;

const metadata = {
  title: "Evenemang",
  description: "Latest news and updates from our team.",
};
---

<BaseLayout metadata={metadata}>
  <section class="relative px-4 py-8 sm:px-6 lg:px-8 md:py-12">
    <div class="absolute inset-0 z-0">
      <div
        class="absolute inset-0 bg-linear-to-br from-blue-500/5 via-transparent to-pink-500/5"
      >
      </div>
    </div>
    <div class="relative mx-auto max-w-5xl">
      <Headline
        tagline={landing?.overline}
        title={landing?.title}
        subtitle={landing?.description}
        classes={{
          container: "reveal mb-12 text-center",
          title:
            "font-heading mb-4 text-4xl font-bold tracking-tight text-foreground md:text-6xl",
          subtitle: "mx-auto max-w-3xl text-xl text-muted-foreground",
        }}
      />

      <div class="flex flex-col gap-8">
        {evenemang.map((post) => <PostItem post={post as any} />)}
      </div>
      <Pagination page={page as any} />
    </div>
  </section>
</BaseLayout>
