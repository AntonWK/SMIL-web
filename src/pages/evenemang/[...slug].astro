---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Schema from "@/components/seo/Schema.astro";
import { sanityClient } from "sanity:client";
import { PortableText } from "astro-portabletext";

export async function getStaticPaths() {
  const query = `*[_type == "evenemang" && defined(slug.current)] {
    title,
    description,
    date,
    eventType,
    "image": image.asset->url,
    location,
    startTime,
    endTime,
    price,
    speaker,
    lastSignupDate,
    body,
    "slug": slug.current
  }`;

  const events = await sanityClient.fetch(query);

  return events.map((event: any) => ({
    params: { slug: event.slug },
    props: {
      post: {
        data: {
          ...event,
          date: new Date(event.date), // Gör om strängen till ett Date-objekt så toLocaleDateString() funkar
        },
        slug: event.slug,
      },
    },
  }));
}

const { post } = Astro.props as any;
const {
  title,
  description,
  date,
  eventType,
  image,
  location,
  startTime,
  endTime,
  price,
  speaker,
  lastSignupDate,
  body,
} = post.data;

const formattedDate = date.toLocaleDateString("sv-SE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const metadata = {
  title: title,
  description: description,
  ogImage: image,
};
---

<BaseLayout metadata={metadata}>
  <Schema
    type="Evenemang"
    data={{
      title,
      description,
      image,
      date,
      eventType,
      location,
      startTime,
      endTime,
      price,
      speaker,
      lastSignupDate,

      url: Astro.url.href,
    }}
  />
  <section class="relative px-4 py-8 sm:px-6 lg:px-8 md:py-12">
    <div class="relative mx-auto max-w-3xl">
      <div class="reveal mb-10 text-center">
        <p class="text-sm font-semibold tracking-wide text-primary capitalize">
          {formattedDate} • {eventType}

          {
            startTime && (
              <>
                <span>• {startTime}</span>
                {endTime && <span>- ca {endTime}</span>}
              </>
            )
          }
        </p>
        <h1
          class="font-heading mt-2 text-3xl font-bold leading-tight tracking-tighter text-foreground sm:text-4xl md:text-5xl"
        >
          {title}
        </h1>
      </div>

      {
        image && (
          <div class="reveal relative mb-8 h-96 w-full overflow-hidden rounded-xl shadow-lg">
            <img src={image} alt={title} class="h-full w-full object-cover" />
          </div>
        )
      }

      <div
        class="reveal prose prose-lg dark:prose-invert mx-auto prose-headings:text-foreground prose-a:text-primary hover:prose-a:underline prose-p:text-muted-foreground prose-strong:text-foreground prose-li:text-muted-foreground prose-code:text-primary"
      >
        <PortableText value={body} />
      </div>
    </div>
  </section>
</BaseLayout>
