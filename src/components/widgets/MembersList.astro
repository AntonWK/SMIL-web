---
import { sanityClient } from "sanity:client";

interface Member {
  name: string;
  url?: string;
}

const query = `*[_type == "members"] | order(company asc) {
    "name": company,
    url
  }`;

const members = await sanityClient.fetch<Member[]>(query);

const groupedMembers: Record<string, Member[]> = {};

members.forEach((member) => {
  if (member.name) {
    const firstLetter = member.name.charAt(0).toUpperCase();

    if (!groupedMembers[firstLetter]) {
      groupedMembers[firstLetter] = [];
    }
    groupedMembers[firstLetter].push(member);
  }
});

const activeLetters = Object.keys(groupedMembers).sort();

const tabs = [...activeLetters];
---

<div class="max-w-5xl mx-auto w-full">
  <nav class="flex flex-wrap justify-center gap-2 mb-8 sticky top-24 z-10 py-4">
    {
      activeLetters.map((letter) => (
        <a
          href={`#bokstav-${letter}`}
          class="inline-block border bg-white border-gray-300 dark:border-slate-700 bg-page px-4 py-2 rounded-md transition-all duration-300 hover:scale-115 hover:border-primary hover:text-primary origin-center text-lg font-medium"
        >
          {letter}
        </a>
      ))
    }
  </nav>

  <hr class="border-gray-200 dark:border-slate-800 mb-12" />

  <div class="space-y-16">
    {
      activeLetters.map((letter) => (
        <section id={`bokstav-${letter}`} class="scroll-mt-36">
          <h2 class="text-4xl font-bold text-primary">{letter}</h2>

          <div class="w-4 h-1 bg-primary rounded-full mt-3 mb-6" />

          <div class="flex flex-col gap-3">
            {groupedMembers[letter].map((member) =>
              member.url ? (
                <a
                  class="inline-block w-fit text-lg underline decoration-primary decoration-2 underline-offset-4 transition-all duration-300 hover:scale-105 origin-left hover:text-primary"
                  href={member.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {member.name}
                </a>
              ) : (
                <p class="text-lg text-gray-700 dark:text-gray-300">
                  {member.name}
                </p>
              ),
            )}
          </div>
        </section>
      ))
    }
  </div>
</div>
