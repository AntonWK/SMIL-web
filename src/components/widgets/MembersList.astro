---
import Tabs from "@/components/bearnie/tabs/Tabs.astro";
import TabsList from "@/components/bearnie/tabs/TabsList.astro";
import TabsTrigger from "@/components/bearnie/tabs/TabsTrigger.astro";
import TabsContent from "@/components/bearnie/tabs/TabsContent.astro";
import { sanityClient } from "sanity:client";

interface Member {
  name: string;
  url?: string;
}

const query = `*[_type == "members"] | order(company asc) {
  "name": company,
  url
}`;

const members = await sanityClient.fetch<Member[]>(query);

const groupedMembers: Record<string, Member[]> = {};

members.forEach((member) => {
  if (member.name) {
    const firstLetter = member.name.charAt(0).toUpperCase();

    if (!groupedMembers[firstLetter]) {
      groupedMembers[firstLetter] = [];
    }
    groupedMembers[firstLetter].push(member);
  }
});

const activeLetters = Object.keys(groupedMembers).sort();

const tabs = [...activeLetters];
---

<Tabs defaultValue={tabs[0]}>
  <TabsList class="w-full flex flex-wrap justify-center gap-2 mb-2">
    {
      tabs.map((tab) => (
        <TabsTrigger
          class="bg-background/80 px-5 py-2.5 text-lg h-auto"
          value={tab}
        >
          {tab}
        </TabsTrigger>
      ))
    }
  </TabsList>
  <hr class="border-gray-200 dark:border-slate-800 mb-8" />
  {
    tabs.map((tab) => (
      <TabsContent value={tab}>
        {groupedMembers[tab].map((member) =>
          member.url ? (
            <a
              class="text-lg underline decoration-primary decoration-2 underline-offset-4 hover:text-primary transition-colors"
              href={member.url}
            >
              {member.name}
            </a>
          ) : (
            <p class="text-lg">{member.name}</p>
          ),
        )}
      </TabsContent>
    ))
  }

  <TabsContent value="account">
    <p>Make changes to your account here.</p>
  </TabsContent></Tabs
>
