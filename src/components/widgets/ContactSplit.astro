---
import WidgetWrapper from "./WidgetWrapper.astro";
import { Icon } from "astro-icon/components";
import Headline from "@/components/ui/Headline.astro";
import Button from "@/components/ui/Button.astro";
import type { SplitContentProps } from "@/types/types";

const {
  title,
  subtitle,
  tagline,
  description = [],
  actions = [],
  isReversed = false,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render("bg"),
  isAfterContent = false,
  columnRatio = "1/2-1/2",
} = Astro.props as SplitContentProps;

const ratioClasses = {
  "1/2-1/2": "md:grid-cols-2",
  "1/3-2/3": "md:grid-cols-[1fr_2fr]",
  "2/3-1/3": "md:grid-cols-[2fr_1fr]",
};

const { container: containerClassProp = "", ...otherClasses } = classes;
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-7xl mx-auto ${containerClassProp}`}
  bg={bg}
  classes={otherClasses}
>
  <div
    class={`grid grid-cols-1 ${ratioClasses[columnRatio]} gap-12 items-start`}
  >
    <div
      class={`self-start text-left ${isReversed ? "md:col-start-2" : "md:col-start-1"}`}
    >
      <Headline
        title={title}
        subtitle={subtitle ||
          (Array.isArray(description)
            ? description.join("<br /><br />")
            : description)}
        tagline={tagline}
        titleAs="h2"
        classes={{
          container: "mb-8",
          title:
            "text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading",
          subtitle: "text-lg text-muted-foreground",
        }}
      />
      <div class="mb-8 text-lg text-muted-foreground">
        <slot name="content" />
      </div>
      {
        Array.isArray(actions) && actions.length > 0 && (
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            {actions.map((action) => (
              <Button
                href={action.href}
                variant={action.variant as "primary" | "secondary"}
                aria-label={action.ariaLabel}
                class="w-full sm:w-auto"
              >
                {action.icon && (
                  <Icon name={action.icon} class="w-5 h-5 mr-2 -ml-1" />
                )}
                {action.text}
              </Button>
            ))}
          </div>
        )
      }
    </div>

    <div
      class={`self-start ${isReversed ? "md:col-start-1" : "md:col-start-2"}`}
    >
      {/* Slot before items if not isAfterContent */}
      {!isAfterContent && <slot />}

      <div class="self-start w-full">
        <!-- placeholder för formulär -->
        <div
          class="bg-muted/30 p-6 md:p-8 rounded-2xl border border-border shadow-sm"
        >
          <h3 class="text-2xl font-bold mb-6">Skicka ett meddelande</h3>

          <form action="#" class="space-y-4" onsubmit="event.preventDefault()">
            <div>
              <label class="block text-sm font-medium mb-1 opacity-70"
                >Namn (Kommande funktion)</label
              >
              <input
                disabled
                type="text"
                class="w-full rounded-xl border-border bg-muted/50 px-4 py-3 opacity-50 cursor-not-allowed"
                placeholder="Ditt namn..."
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1 opacity-70"
                >E-post (Kommande funktion)</label
              >
              <input
                disabled
                type="email"
                class="w-full rounded-xl border-border bg-muted/50 px-4 py-3 opacity-50 cursor-not-allowed"
                placeholder="din@epost.se"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1 opacity-70"
                >Meddelande</label
              >
              <textarea
                disabled
                rows="4"
                class="w-full rounded-xl border-border bg-muted/50 px-4 py-3 opacity-50 cursor-not-allowed resize-none"
                placeholder="Skriv ditt ärende här..."></textarea>
            </div>
            <div class="pt-2">
              <Button
                type="button"
                variant="primary"
                class="w-full opacity-60 cursor-not-allowed"
              >
                Skicka meddelande
              </Button>
            </div>
          </form>
        </div>
        <!-- placeholder för formulär end -->
      </div>
      {isAfterContent && <slot />}
    </div>
  </div>
</WidgetWrapper>
